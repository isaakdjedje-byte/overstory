{
	"name": "@os-eco/overstory-cli-opencode",
	"version": "0.7.0-opencode",
	"description": "Multi-agent orchestration for OpenCode — spawn worker agents in git worktrees, coordinate through SQLite mail, merge with tiered conflict resolution",
	"author": "Jaymin West (adapted for OpenCode by isaakdjedje-byte)",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/isaakdjedje-byte/overstory.git"
	},
	"homepage": "https://github.com/isaakdjedje-byte/overstory",
	"keywords": [
		"ai",
		"agents",
		"orchestration",
		"claude-code",
		"opencode",
		"multi-agent",
		"swarm",
		"cli",
		"developer-tools"
	],
	"bin": {
		"overstory": "./src/index.ts",
		"ov": "./src/index.ts"
	},
	"main": "src/index.ts",
	"files": [
		"src",
		"agents",
		"templates",
		"opencode-plugin",
		"opencode-skill"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.0"
	},
	"scripts": {
		"test": "bun test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"version:bump": "bun scripts/version-bump.ts",
		"plugin:run": "bun run opencode-plugin/index.ts",
		"opencode:setup": "bun scripts/setup-opencode.ts"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"commander": "^14.0.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"typescript": "^5.9.0",
		"@biomejs/biome": "^2.3.15"
	},
	"opencode": {
		"plugin": {
			"entry": "opencode-plugin/index.ts",
			"enabled": true
		},
		"skill": {
			"path": "opencode-skill/SKILL.md",
			"name": "overstory-orchestrator"
		},
		"features": [
			"hybrid-spawning",
			"sqlite-mail",
			"worktree-isolation",
			"plugin-hooks"
		]
	}
}
